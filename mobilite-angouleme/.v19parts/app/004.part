  $('#tad').innerHTML=tad ? `<article class="card info-card compact-info"><h3>${esc(tad.service||tad.provider||'Transport à la demande')}</h3>${tad.short?`<p>${esc(tad.short)}</p>`:''}<div class="info-actions">${tad.phone?`<a class="secondary-link" href="tel:${String(tad.phone).replace(/\s/g,'')}">☎ ${esc(tad.phone)}</a>`:''}${tad.url?`<a class="secondary-link" href="${escAttr(tad.url)}" target="_blank" rel="noopener noreferrer">Voir / réserver ↗</a>`:''}</div></article>` : `<div class="empty">Aucune information TAD publique intégrée pour ${esc(locality)}.</div>${sourceError('tad')}`;
  renderUrbanTransit();

  const inter=x.interurban?.stops||[]; $('#interurbanCount').textContent=`${inter.length} arrêt${inter.length>1?'s':''} · ≤ ${getRadius('#interurbanRadius',10)} min`; $('#interurban').innerHTML=renderTransitStops(inter,'Aucun arrêt de car interurbain trouvé dans ce rayon.')+sourceError('interurban');
  const long=x.longDistance?.stops||[]; $('#longDistanceCount').textContent=`${long.length} arrêt${long.length>1?'s':''} · ≤ ${getRadius('#longDistanceRadius',15)} min`; $('#longDistance').innerHTML=renderTransitStops(long,'Aucun départ longue distance trouvé dans ce rayon.')+sourceError('longDistance');

  const carpool=x.carpool||[]; $('#carpoolCount').textContent=`${carpool.length} lieu${carpool.length>1?'x':''} · ≤ ${getRadius('#carpoolRadius',15)} min`; $('#carpool').innerHTML=carpool.length?carpool.slice(0,8).map((c,i)=>`<article class="card"><span class="rank">#${i+1} · 🚶 ${c.walkMinutes} min · ${fmtDistance(c.distanceMeters)}</span><h3>${esc(c.name)}</h3>${c.address?`<p class="card-note">${esc(c.address)}</p>`:''}${Number.isFinite(c.capacity)?`<div class="mini-stat">${c.capacity} place${c.capacity>1?'s':''}</div>`:''}</article>`).join(''):`<div class="empty">Aucun lieu de covoiturage public trouvé dans ce rayon.</div>${sourceError('carpool')}`;

  const parks=x.parking||[]; $('#parkingCount').textContent=`${parks.length} parking${parks.length>1?'s':''} · ≤ ${getRadius('#parkingRadius',15)} min`; $('#parking').innerHTML=parks.length?parks.slice(0,8).map((p,i)=>`<article class="card"><span class="rank">#${i+1} · 🚶 ${p.walkMinutes} min · ${fmtDistance(p.distanceMeters)}</span><h3>${p.parkAndRide?'P+R · ':''}${esc(p.name)}</h3>${p.address?`<p class="card-note">${esc(p.address)}</p>`:''}<div class="feature-chips">${Number.isFinite(p.capacity)?`<span>${p.capacity} places</span>`:''}${p.opening?`<span>${esc(p.opening)}</span>`:''}${p.free?`<span>${esc(p.free)}</span>`:''}</div><p class="card-note">Disponibilité temps réel affichée uniquement si la source publique la fournit.</p></article>`).join(''):`<div class="empty">Aucun parking public trouvé dans ce rayon.</div>${sourceError('parking')}`;

  const charging=x.charging||[]; $('#chargingCount').textContent=`${charging.length} point${charging.length>1?'s':''} · ≤ ${getRadius('#chargingRadius',15)} min`; $('#charging').innerHTML=charging.length?charging.slice(0,10).map((c,i)=>`<article class="card"><span class="rank">#${i+1} · 🚶 ${c.walkMinutes} min · ${fmtDistance(c.distanceMeters)}</span><h3>${esc(c.name)}</h3>${c.address?`<p class="card-note">${esc(c.address)}</p>`:''}<div class="feature-chips">${Number.isFinite(c.nbPoints)?`<span>${c.nbPoints} point${c.nbPoints>1?'s':''}</span>`:''}${Number.isFinite(c.powerKw)?`<span>${c.powerKw} kW</span>`:''}${c.status?`<span class="charge-status">${esc(statusLabel(c.status))}</span>`:''}</div></article>`).join(''):`<div class="empty">Aucune borne de recharge publique trouvée dans ce rayon.</div>${sourceError('charging')}`;
}

function renderBestOption(){
  const target=$('#bestOption'); if(!target) return;
  if(!state.data){ target.innerHTML='<div class="empty">Chargement…</div>'; return; }
  const buffer=Number($('#buffer').value||2); const options=[];
  for(const s of state.data.busStops||[]){
    for(const d of s.directions||[]){ for(const r of d.routeDirections||[]){ const p=r.passages?.[0]; if(!p)continue; const mins=Number(p.minutes); const leave=mins-s.walkMinutes-buffer; if(leave>=0) options.push({kind:'Bus',icon:'🚌',title:`${r.route} · ${r.headsign||''}`,subtitle:`Arrêt ${s.name} · ${s.walkMinutes} min à pied`,when:p.realtime?(mins===0?'à l’arrêt':mins===1?'proche':`dans ${mins} min`):p.time,leave,score:leave}); } }
  }
  const bike=(state.data.bikes||[]).find(b=>b.bikesAvailable>0); if(bike) options.push({kind:'Vélo',icon:'🚲',title:bike.name,subtitle:`${bike.bikesAvailable} vélo${bike.bikesAvailable>1?'s':''} disponible${bike.bikesAvailable>1?'s':''}`,when:`${bike.walkMinutes} min à pied`,leave:bike.walkMinutes,score:bike.walkMinutes+2});
  const stationWalk=state.extras?.trainStationWalk?.walkMinutes; const firstTrain=state.trains?.departures?.[0]; if(Number.isFinite(stationWalk)&&firstTrain){ const now=Date.now()/1000; const mins=firstTrain.epoch?Math.max(0,Math.round((Number(firstTrain.epoch)-now)/60)):null; if(mins==null||mins>=stationWalk+buffer) options.push({kind:'Train',icon:'🚆',title:`${firstTrain.service||'Train'} · ${firstTrain.destination||''}`,subtitle:`${state.trains?.station || 'Gare la plus proche'} · ${stationWalk} min à pied`,when:trainClockFromDeparture(firstTrain),leave:mins==null?stationWalk:Math.max(0,mins-stationWalk-buffer),score:mins==null?stationWalk+20:Math.max(0,mins-stationWalk-buffer)}); }
  for(const s of state.extras?.tbm?.stops||[]){ const svc=s.services?.[0],p=svc?.passages?.[0]; if(!p)continue; const leave=p.minutes-s.walkMinutes-buffer; if(leave>=0) options.push({kind:`TBM ${svc.mode||''}`.trim(),icon:svc.mode==='Tram'?'🚊':svc.mode==='Métro'?'🚇':svc.mode==='Bateau'?'⛴️':'🚌',title:`${svc.line||''} · ${svc.destination}`,subtitle:`${s.name} · ${s.walkMinutes} min à pied`,when:p.realtime?(p.minutes===0?'à l’arrêt':p.minutes===1?'proche':`dans ${p.minutes} min`):fmtCoachTime(p.time),leave,score:leave}); }
  for(const [kind,data,icon] of [['Car interurbain',state.extras?.interurban,'🚌'],['Car longue distance',state.extras?.longDistance,'🧳']]){ for(const s of data?.stops||[]){ const svc=s.services?.[0],p=svc?.passages?.[0]; if(!p)continue; const leave=p.minutes-s.walkMinutes-buffer; if(leave>=0) options.push({kind,icon,title:`${svc.operator||svc.line||kind} · ${svc.destination}`,subtitle:`${s.name} · ${s.walkMinutes} min à pied`,when:fmtCoachTime(p.time),leave,score:leave}); } }
  options.sort((a,b)=>a.score-b.score); const best=options[0],alt=options.slice(1,4);
  if(!best){ target.innerHTML='<div class="empty">Aucune option attrapable immédiatement avec les données disponibles.</div>'; return; }
