      await streamCsvUrl(dynUrl,row=>{const id=String(firstField(row,['id_pdc_itinerance','id_station_itinerance','id_station','id'])||''); if(!wanted.has(id))return; const st=String(firstField(row,['statut_pdc','status','etat_pdc','etat'])||''); if(st)statuses.set(id,st);});
      for(const x of selected)x.status=statuses.get(x.id)||statuses.get(x.stationId)||'';
    }
  }catch(e){console.warn('IRVE dynamique indisponible:',e.message);}
  const grouped=new Map();
  for(const x of selected){ const k=x.stationId||`${normalizeText(x.name)}|${x.lat.toFixed(5)}|${x.lon.toFixed(5)}`; if(!grouped.has(k)) grouped.set(k,{...x,nbPoints:0,statuses:[]}); const g=grouped.get(k); g.nbPoints += Number.isFinite(x.nbPoints)&&x.nbPoints>0 ? x.nbPoints : 1; if(x.status&&!g.statuses.includes(x.status))g.statuses.push(x.status); if(Number.isFinite(x.powerKw))g.powerKw=Math.max(Number(g.powerKw)||0,x.powerKw); }
  const value=[...grouped.values()].map(g=>({...g,status:g.statuses.join(' · ')})).slice(0,12);
  irveQueryCache.set(cacheKey,{loadedAt:Date.now(),value});
  return value;
}

async function tbmRealtimeMaps() {
  const byTripStop=new Map(), alertsByRoute=new Map();
  try{
    const r=await fetchOk(TBM_GTFS_RT_URL); const feed=GtfsRealtimeBindings.transit_realtime.FeedMessage.decode(new Uint8Array(await r.arrayBuffer()));
    const now=Math.floor(Date.now()/1000);
    for(const e of feed.entity||[]){ const tu=e.tripUpdate,tripId=tu?.trip?.tripId;if(!tripId)continue; for(const stu of tu.stopTimeUpdate||[]){const epoch=Number(stu.departure?.time||stu.arrival?.time||0);if(epoch&&epoch>=now-90&&epoch<=now+4*3600)byTripStop.set(`${tripId}|${stu.stopId}`,epoch);} }
  }catch(e){console.warn('TBM GTFS-RT indisponible:',e.message);}
  try{
    const r=await fetchOk(TBM_GTFS_ALERTS_URL); const feed=GtfsRealtimeBindings.transit_realtime.FeedMessage.decode(new Uint8Array(await r.arrayBuffer()));
    for(const e of feed.entity||[]){const a=e.alert;if(!a)continue;const text=(a.headerText?.translation?.[0]?.text||a.descriptionText?.translation?.[0]?.text||'Perturbation');for(const ie of a.informedEntity||[]){if(!ie.routeId)continue;if(!alertsByRoute.has(ie.routeId))alertsByRoute.set(ie.routeId,[]);alertsByRoute.get(ie.routeId).push(text);}}
  }catch(e){console.warn('TBM alertes indisponibles:',e.message);}
  return {byTripStop,alertsByRoute};
}

function tbmMode(route={}){const t=String(route.route_type??'');return t==='0'?'Tram':t==='1'?'Métro':t==='4'?'Bateau':'Bus';}

function isNearBordeaux(lat,lon){return haversineMeters(lat,lon,44.8378,-0.5792)<60000;}
async function getTbmNearby(lat,lon,speedKmh,maxWalkMin){
  if(!isNearBordeaux(lat,lon)) return {source:TBM_GTFS_STATIC_URL,realtimeSource:TBM_GTFS_RT_URL,stops:[]};
  const gtfs=await loadGenericGtfs(TBM_GTFS_STATIC_URL,'tbm'); const active=genericActiveServices(gtfs),{seconds}=parisParts(),nowEpoch=Math.floor(Date.now()/1000),rt=await tbmRealtimeMaps();
  const nearby=gtfs.stops.filter(s=>!s.location_type||s.location_type==='0').map(s=>{const slat=Number(s.stop_lat),slon=Number(s.stop_lon),d=haversineMeters(lat,lon,slat,slon);return{id:s.stop_id,name:s.stop_name,lat:slat,lon:slon,distanceMeters:Math.round(d),walkMinutes:Math.ceil(walkMinutes(d,speedKmh))}}).filter(s=>Number.isFinite(s.lat)&&Number.isFinite(s.lon)&&s.walkMinutes<=maxWalkMin).sort((a,b)=>a.distanceMeters-b.distanceMeters).slice(0,36);
  const groups=new Map();for(const st of nearby){const k=normalizeText(st.name);if(!groups.has(k))groups.set(k,{...st,stopIds:[]});groups.get(k).stopIds.push(st.id)}
  const result=[];
  for(const stop of [...groups.values()].sort((a,b)=>a.distanceMeters-b.distanceMeters).slice(0,12)){
    const services=new Map();
    for(const stopId of stop.stopIds)for(const st of gtfs.stopTimesByStop.get(stopId)||[]){const depSec=gtfsTimeToSeconds(st.departure_time||st.arrival_time);if(depSec==null||depSec<seconds-60||depSec>seconds+3*3600)continue;const trip=gtfs.tripById.get(st.trip_id);if(!trip||!active.has(trip.service_id))continue;const route=gtfs.routeById.get(trip.route_id)||{};const line=route.route_short_name||route.route_long_name||'',dest=genericDestination(gtfs,st.trip_id,stopId),mode=tbmMode(route),key=`${line}|${dest}|${mode}`,epoch=rt.byTripStop.get(`${st.trip_id}|${stopId}`)||0,mins=epoch?Math.max(0,Math.round((epoch-nowEpoch)/60)):Math.max(0,Math.round((depSec-seconds)/60));if(!services.has(key))services.set(key,{line,destination:dest,mode,color:route.route_color||'',alerts:rt.alertsByRoute.get(trip.route_id)||[],passages:[]});services.get(key).passages.push({time:formatGtfsClock(st.departure_time||st.arrival_time),minutes:mins,realtime:Boolean(epoch),epoch:epoch||null});}
    const arr=[...services.values()].map(x=>({...x,passages:x.passages.sort((a,b)=>a.minutes-b.minutes).slice(0,3)})).filter(x=>x.passages.length).sort((a,b)=>a.passages[0].minutes-b.passages[0].minutes);result.push({...stop,services:arr,served:arr.length>0});
  }
  return {source:TBM_GTFS_STATIC_URL,realtimeSource:TBM_GTFS_RT_URL,stops:result};
}


function isNearGrandAngouleme(lat,lon){ return haversineMeters(lat,lon,45.6484,0.1562)<45000; }

async function getBikes(lat, lon, speedKmh, maxWalkMin, limit=4) {
  if(!isNearGrandAngouleme(lat,lon)) return [];
  const [infoR,statusR]=await Promise.all([fetchOk(BIKE_INFO_URL),fetchOk(BIKE_STATUS_URL)]);
  const [info,status]=await Promise.all([infoR.json(),statusR.json()]);
  const statusById=new Map((status?.data?.stations||[]).map(x=>[String(x.station_id),x]));
  return (info?.data?.stations||[]).map(st=>{
    const slat=Number(st.lat),slon=Number(st.lon),distance=haversineMeters(lat,lon,slat,slon),ss=statusById.get(String(st.station_id))||{};
    return {
      id:`modalis:${st.station_id}`,name:localizedText(st.name,'Vélo Modalis'),network:'Vélo Modalis',lat:slat,lon:slon,
      distanceMeters:Math.round(distance),walkMinutes:Math.ceil(walkMinutes(distance,speedKmh)),
      bikesAvailable:Number(ss.num_bikes_available??ss.num_vehicles_available??0),
      docksAvailable:Number(ss.num_docks_available??0),
      isInstalled:ss.is_installed!==0,isRenting:ss.is_renting!==0,isReturning:ss.is_returning!==0
    };
  }).filter(x=>Number.isFinite(x.lat)&&Number.isFinite(x.lon)&&x.walkMinutes<=maxWalkMin&&x.isInstalled&&x.isRenting)
    .sort((a,b)=>a.distanceMeters-b.distanceMeters).slice(0,limit);
}

function localizedText(value, fallback='') {
  if (value == null) return fallback;
  if (typeof value === 'string' || typeof value === 'number') return String(value);
  if (Array.isArray(value)) {
    const preferred = value.find(v => String(v?.language || v?.lang || '').toLowerCase().startsWith('fr')) || value[0];
    return localizedText(preferred, fallback);
  }
  if (typeof value === 'object') {
    if (typeof value.text === 'string') return value.text;
    if (typeof value.name === 'string') return value.name;
    if (typeof value.value === 'string') return value.value;
    if (typeof value.fr === 'string') return value.fr;
