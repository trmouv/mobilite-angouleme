.compact-card{padding:15px}.service-list{display:flex;flex-direction:column;gap:9px;margin-top:12px}.service-row{display:grid;grid-template-columns:104px minmax(0,1fr);gap:10px;align-items:center;background:var(--surface-2);border-radius:12px;padding:10px}.service-badge{display:flex;align-items:center;justify-content:center;min-height:34px;padding:6px 8px;border-radius:9px;background:#1f2937;color:white;font-size:11px;font-weight:1000;text-align:center}.service-badge.op-flix{background:#73d700;color:#111}.service-badge.op-blabla{background:#086788;color:#fff}.service-badge.op-region{background:#243b80;color:#fff}.service-destination{font-weight:850}.line-code{display:inline-block;background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:2px 6px;margin-right:4px;font-size:12px}.service-times{display:flex;gap:7px;flex-wrap:wrap;margin-top:6px}.service-times span{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:5px 8px;font-size:13px;font-weight:800}.info-card p{color:var(--muted);line-height:1.55}.info-actions{display:flex;gap:8px;flex-wrap:wrap}.secondary-link{display:inline-flex;align-items:center;min-height:38px;padding:8px 11px;border:1px solid var(--line-strong);border-radius:10px;color:var(--text);font-weight:800;text-decoration:none;background:var(--surface-2)}.card-note{color:var(--muted);font-size:12px;line-height:1.45;margin:7px 0 0}.mini-stat{display:inline-flex;margin-top:10px;padding:6px 9px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);font-size:12px;font-weight:800}.feature-chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.feature-chips span{padding:6px 8px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);font-size:12px;font-weight:800}.charge-status{color:var(--live)}.source-note{margin-top:8px;color:var(--muted);font-size:11px;opacity:.75}
@media(max-width:760px){.best-main{grid-template-columns:auto 1fr}.best-when{grid-column:2}.alternatives{grid-template-columns:1fr}.alternatives>span{margin-top:3px}.service-row{grid-template-columns:88px minmax(0,1fr)}}
@media(max-width:420px){.best-card{padding:14px}.best-main{gap:10px}.best-icon{width:42px;height:42px}.best-main h3{font-size:17px}.best-when{font-size:16px}.service-row{grid-template-columns:1fr}.service-badge{justify-self:start;min-width:88px}}
/* v16 — TBM multi-territoires */
.service-badge.tbm-tram{background:#6d28d9;color:#fff}.service-badge.tbm-bus{background:#0f766e;color:#fff}.service-badge.tbm-bat3{background:#0369a1;color:#fff}.time-live{color:var(--live);font-weight:900}.danger-note{color:var(--danger)}
.service-badge.tbm-metro{background:#7c3aed;color:#fff}.service-badge.tbm-bateau{background:#0369a1;color:#fff}.compact-info p{margin:.35rem 0 .75rem}

/* v18 : regrouper les arrêts proches sans passage prévu */
.unserved-group{margin-top:12px;border:1px dashed var(--line-strong);border-radius:16px;background:var(--surface);overflow:hidden}
.unserved-group summary{cursor:pointer;list-style:none;padding:13px 15px;font-weight:850;color:var(--muted);display:flex;align-items:center;justify-content:space-between;gap:10px}
.unserved-group summary::-webkit-details-marker{display:none}
.unserved-group summary span{min-width:28px;text-align:center;padding:3px 8px;border-radius:999px;background:var(--surface-2);color:var(--text);font-size:12px}
.unserved-list{border-top:1px solid var(--line);padding:4px 14px 10px}
.unserved-stop{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.unserved-stop:last-child{border-bottom:0}.unserved-stop strong{display:block}.unserved-stop span{display:block;margin-top:2px;font-size:11px;color:var(--muted)}

/* v19 – directions TBM regroupées et horaires trains neutres */
.service-direction + .service-direction{margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}
.train-time strong,.train-next-time{color:var(--text)!important}
.train-next-live,.train-time-live strong{color:var(--text)!important}
