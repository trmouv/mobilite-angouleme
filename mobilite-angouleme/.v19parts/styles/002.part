@media(max-width:760px){.shell{padding-top:18px}.topbar{align-items:flex-start}.lede{font-size:15px}.header-actions{gap:6px}.icon-btn{width:42px;height:42px}.grid{grid-template-columns:1fr}.section-title{margin-top:22px;align-items:flex-start;flex-direction:column}.pill{align-self:flex-start}.bus-card,.card{border-radius:15px}.bus-head{display:grid;grid-template-columns:minmax(0,1fr) auto}.arrival{grid-template-columns:48px minmax(0,1fr);padding:10px 9px}.route{align-self:start}.bike-numbers{gap:8px}.metric b{font-size:22px}}
@media(max-width:520px){.shell{padding-left:12px;padding-right:12px}.topbar{display:block}.header-actions{position:absolute;top:max(12px,env(safe-area-inset-top));right:12px}.brand-block{padding-right:142px}.eyebrow{font-size:10px}.lede{margin-top:10px}.section-title h2{font-size:19px}.bus-card,.card{padding:13px}.stop-title-row{display:grid;grid-template-columns:1fr}.direction-toggle{width:max-content;max-width:100%}.walk{font-size:12px}.rank{font-size:11px}.arrival{grid-template-columns:44px minmax(0,1fr)}.route{padding:6px 4px}.headsign{font-size:13px}.settings-actions{grid-template-columns:1fr}.settings-drawer{width:100%}}
@media(max-width:390px){.brand-block{padding-right:0;padding-top:52px}.header-actions{left:12px;right:auto}.arrival{grid-template-columns:40px minmax(0,1fr)}}
.future-window{opacity:.6}.future-arrival{opacity:1}

.route-direction-next{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}

/* Perturbations trafic : signal compact, détails uniquement au clic */
.disruption-toggle{display:inline-flex;align-items:center;gap:7px;margin:0 0 8px;padding:5px 9px;border:1px solid color-mix(in srgb,var(--danger) 38%,var(--line));border-radius:999px;background:color-mix(in srgb,var(--danger) 8%,var(--surface));color:var(--danger);font:inherit;font-size:12px;font-weight:900;cursor:pointer;line-height:1.2}
.disruption-toggle:hover{background:color-mix(in srgb,var(--danger) 13%,var(--surface))}.disruption-toggle[aria-expanded="true"]{border-radius:10px}
.disruption-icon{width:17px;height:17px;display:grid;place-items:center;border-radius:50%;background:var(--danger);color:white;font-size:11px;font-weight:1000;flex:0 0 auto}
.disruption-details{margin:0 0 10px;padding:10px;border:1px solid color-mix(in srgb,var(--danger) 26%,var(--line));border-radius:12px;background:color-mix(in srgb,var(--danger) 5%,var(--surface));font-size:12px;line-height:1.45}.disruption-details[hidden]{display:none}.disruption-item+.disruption-item{margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}.disruption-item h4{margin:0 0 6px;font-size:13px;color:var(--danger)}.disruption-text{color:var(--text);max-height:220px;overflow:auto;padding-right:4px}.disruption-item a{display:inline-block;margin-top:7px;color:var(--danger);font-weight:800;text-decoration:none}.disruption-item a:hover{text-decoration:underline}.disruption-loading{color:var(--muted)}


/* Prochains trains SNCF */
.train-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}
.train-row{display:grid;grid-template-columns:minmax(115px,.7fr) minmax(0,2fr);gap:14px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.train-row:last-child{border-bottom:0}.train-service{display:flex;align-items:center;gap:8px;min-width:0;border-left:4px solid var(--line-strong);padding-left:10px}.train-service strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px}.train-logo{display:block;max-width:96px;width:auto;height:30px;object-fit:contain}.train-main{display:flex;align-items:center;justify-content:space-between;gap:14px;min-width:0}.train-route{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;min-width:0}.train-destination{font-weight:800;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.train-times{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap}.train-time,.train-next-time{display:inline-flex;align-items:center;gap:6px;min-width:max-content;padding:6px 9px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);font-weight:800}.train-time-live strong,.train-next-live{color:var(--live)}.train-delay{display:inline-flex;align-items:center;min-width:max-content;padding:5px 8px;border-radius:999px;background:color-mix(in srgb,var(--danger) 8%,var(--surface));border:1px solid color-mix(in srgb,var(--danger) 26%,var(--line));color:var(--danger);font-size:12px;font-weight:900}.live-dot.small{width:6px;height:6px}
@media(max-width:620px){.train-row{grid-template-columns:1fr;gap:8px}.train-main{align-items:flex-start}.train-route{align-items:flex-start;flex-direction:column;gap:8px}.train-destination{white-space:normal}.train-service{padding-left:8px}.train-logo{height:28px;max-width:90px}.train-times{justify-content:flex-start}.train-time{margin-left:0}}


/* v13 – badges trains harmonisés + voie du prochain départ */
.train-service{min-height:44px}
.train-logo{width:118px;height:34px;max-width:118px;object-fit:contain}
.train-platform{display:inline-flex;align-items:center;min-width:max-content;padding:5px 8px;border-radius:999px;background:var(--surface);border:1px solid var(--line-strong);color:var(--text);font-size:12px;font-weight:900}
@media(max-width:620px){.train-logo{width:108px;height:32px;max-width:108px}}

/* v15 — tableau multimodal */
.hero-section{margin-top:8px}.best-option{min-height:110px}.best-card{background:linear-gradient(135deg,var(--surface),var(--surface-2));border:1px solid var(--line-strong);border-radius:22px;padding:18px;box-shadow:var(--shadow)}.best-kicker{font-size:11px;font-weight:1000;letter-spacing:.08em;color:var(--accent);margin-bottom:10px}.best-main{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;align-items:center}.best-icon{width:48px;height:48px;border-radius:15px;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center;font-size:25px}.best-kind{font-size:12px;color:var(--muted);font-weight:900;text-transform:uppercase}.best-main h3{margin:2px 0 3px;font-size:20px}.best-main p{margin:0;color:var(--muted);font-size:13px}.best-when{font-size:19px;font-weight:1000;white-space:nowrap}.best-leave{margin-top:13px;padding-top:12px;border-top:1px solid var(--line);font-size:14px}.alternatives{margin-top:12px;display:grid;grid-template-columns:auto repeat(3,minmax(0,1fr));gap:8px;align-items:stretch}.alternatives>span{align-self:center;color:var(--muted);font-size:11px;font-weight:900;text-transform:uppercase}.alternatives>div{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:9px}.alternatives b,.alternatives small{display:block}.alternatives small{margin-top:3px;color:var(--muted);line-height:1.3}
