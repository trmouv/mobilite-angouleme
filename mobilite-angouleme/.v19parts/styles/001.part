:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--bg:#f4f6f8;--surface:#fff;--surface-2:#f8fafc;--text:#111827;--muted:#64748b;--line:#e5e7eb;--line-strong:#cbd5e1;--accent:#111827;--shadow:0 4px 20px rgba(15,23,42,.06);--live:#047857;--danger:#b91c1c;color:var(--text);background:var(--bg)}
html[data-theme="dark"]{--bg:#0b1120;--surface:#111827;--surface-2:#182235;--text:#f8fafc;--muted:#9ca9bc;--line:#263247;--line-strong:#3a4961;--accent:#f8fafc;--shadow:0 8px 28px rgba(0,0,0,.22);--live:#34d399;--danger:#f87171;color-scheme:dark}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}body{margin:0;min-height:100dvh;background:var(--bg);color:var(--text);transition:background .2s,color .2s}.shell{max-width:980px;margin:auto;padding:28px max(18px,env(safe-area-inset-right)) max(60px,calc(env(safe-area-inset-bottom) + 28px)) max(18px,env(safe-area-inset-left))}.topbar{display:flex;gap:20px;justify-content:space-between;align-items:flex-start;margin-bottom:16px}.brand-block{min-width:0}.eyebrow{font-size:12px;letter-spacing:.12em;font-weight:800;color:var(--muted);margin:0 0 6px}h1{font-size:clamp(30px,6vw,52px);letter-spacing:-.04em;line-height:1;margin:0}.lede{color:var(--muted);font-size:17px;margin-bottom:0}.header-actions{display:flex;gap:8px;flex-wrap:nowrap;justify-content:flex-end;position:sticky;top:12px;z-index:10}.icon-btn{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--line-strong);border-radius:12px;background:var(--surface);color:var(--text);font-size:20px;font-weight:900;cursor:pointer;box-shadow:0 2px 8px rgba(15,23,42,.04)}.icon-btn:hover{background:var(--surface-2)}.install-hidden{display:none!important}.status{margin:12px 0 20px;color:var(--muted);font-size:14px}.status.error{color:var(--danger)}.section-title{margin:28px 0 12px;display:flex;justify-content:space-between;gap:12px;align-items:center}.section-title>div{display:flex;align-items:center;gap:9px}.section-title h2{margin:0;font-size:22px}.icon{font-size:24px}.pill{font-size:12px;font-weight:700;background:var(--surface-2);border:1px solid var(--line);padding:7px 10px;border-radius:999px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card,.bus-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}.card{padding:16px}.rank{color:var(--muted);font-weight:900;font-size:12px}.card h3,.bus-card h3{margin:4px 0 6px;font-size:18px}.bike-numbers{display:flex;gap:10px;margin-top:14px}.metric{flex:1;background:var(--surface-2);border-radius:12px;padding:10px}.metric b{display:block;font-size:24px}.metric span{font-size:12px;color:var(--muted)}.stack{display:flex;flex-direction:column;gap:12px}.bus-card{padding:16px}.bus-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.stop-title-wrap{min-width:0;flex:1}.stop-title-row{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.stop-title-row h3{margin:4px 0 2px}.walk{font-weight:800;white-space:nowrap}.direction-toggle{border:1px solid var(--line-strong);background:var(--surface);color:var(--text);border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;cursor:pointer;white-space:nowrap}.direction-toggle:hover{background:var(--surface-2)}.direction-label{font-size:12px;color:var(--muted);margin-top:2px}.direction-label span{display:inline-block;margin-left:4px;background:var(--surface-2);padding:2px 6px;border-radius:999px;font-weight:800;color:var(--muted)}.arrivals{display:flex;flex-direction:column;gap:8px;margin-top:12px}.arrival{width:100%;border:0;text-align:left;display:grid;grid-template-columns:58px minmax(0,1fr);gap:10px;align-items:center;background:var(--surface-2);color:var(--text);border-radius:12px;padding:10px;font:inherit}.route{font-weight:900;text-align:center;border-radius:8px;padding:7px;background:#111827;color:white}.route-main{min-width:0}.headsign{font-size:14px;font-weight:800}.passage-list{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:7px}.passage{display:inline-flex;align-items:center;gap:5px;min-height:28px;padding:5px 8px;border-radius:999px;background:var(--surface);border:1px solid var(--line);font-size:13px;white-space:nowrap}.passage strong{font-size:14px}.passage small{font-size:10px;font-weight:800;color:var(--muted);margin-left:2px}.realtime-passage strong{color:var(--live)}.leave-advice{margin-top:6px;font-size:11px;color:var(--muted)}.leave-advice strong{color:var(--text);font-size:12px}.live-dot{width:8px;height:8px;border-radius:50%;background:var(--live);flex:0 0 auto}.empty{color:var(--muted);padding:14px 0}footer{margin-top:36px;color:var(--muted);font-size:12px;line-height:1.5}
.settings-backdrop{position:fixed;inset:0;background:rgba(2,6,23,.45);z-index:40;opacity:0;transition:opacity .2s}.settings-backdrop.show{opacity:1}.settings-drawer{position:fixed;z-index:50;top:0;right:0;width:min(430px,100%);height:100dvh;background:var(--surface);color:var(--text);box-shadow:-12px 0 40px rgba(2,6,23,.2);transform:translateX(102%);transition:transform .22s ease;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top)}.settings-drawer.open{transform:translateX(0)}.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:20px 20px 14px;border-bottom:1px solid var(--line)}.drawer-head h2{margin:0;font-size:26px}.settings-content{padding:20px;overflow:auto}.field-group{margin-bottom:22px}.field-group label{font-weight:800;display:flex;justify-content:space-between;gap:10px;margin-bottom:8px}.field-group textarea,.field-group select{width:100%;border:1px solid var(--line-strong);border-radius:12px;background:var(--surface-2);color:var(--text);padding:12px 13px;font:inherit;min-height:46px}.field-group textarea{resize:vertical}.settings-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.primary-btn,.secondary-btn{min-height:44px;border-radius:12px;padding:10px 12px;font-weight:800;cursor:pointer}.primary-btn{background:var(--accent);color:var(--bg);border:0}.secondary-btn{background:var(--surface);color:var(--text);border:1px solid var(--line-strong)}.primary-btn:disabled,.secondary-btn:disabled{opacity:.55;cursor:wait}.muted{color:var(--muted);font-size:13px;line-height:1.4}.field-group input[type="range"]{width:100%;accent-color:var(--accent)}.range-hints{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:4px}.drawer-open{overflow:hidden}
